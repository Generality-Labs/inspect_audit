%%% STANDARDISED REPORT STRUCTURE %%%

% ---- Content fields -------------------------------------------------
% Reports set values with \setfield{key}{value}; shared structure pages
% render them with \field{key}. Unset fields show a visible [key?] marker.
\newcommand{\setfield}[2]{\expandafter\def\csname fld@#1\endcsname{#2}}
\newcommand{\field}[1]{%
  \ifcsname fld@#1\endcsname\csname fld@#1\endcsname\else\textbf{[#1?]}\fi}
% Render #2 only when field #1 has been set (for optional structure blocks)
\newcommand{\iffield}[2]{\ifcsname fld@#1\endcsname#2\fi}

% Example contributions are stored as comma-separated \gsub{name}{short
% description} items. \dimsubdescribed{key} renders them as a numbered
% two-column list: A.1 name --- description. The codes (A.1, B.3, ...)
% are the issue vocabulary referenced from the Audit Findings.
\newbool{gl@colA}
\newcounter{gl@subidx}
\newcommand{\gsub}[2]{}% placeholder; renderers redefine locally
% Optional per-dimension start offset: contributions normally number from
% .1; \dimensionsubbase{key}{-1} makes them start at .0.
\newcommand{\dimensionsubbase}[2]{\expandafter\def\csname dim@subbase@#1\endcsname{#2}}
\newcommand{\dimsubdescribed}[1]{%
  \setcounter{gl@subidx}{\ifcsname dim@subbase@#1\endcsname\csname dim@subbase@#1\endcsname\else0\fi}%
  \def\gsub##1##2{\stepcounter{gl@subidx}%
    {\bfseries\color{brandTeal}\dimletter{#1}.\arabic{gl@subidx}}~{\bfseries \glupfirst{##1}} --- ##2\par}%
  \renewcommand*{\do}[1]{##1}%
  \letcs\gl@items{dim@sub@#1}%
  \noindent\expandafter\docsvlist\expandafter{\gl@items}\par}
% Issue-code reference (e.g. \iss{B.1}) styled like the criteria codes.
\newcommand{\iss}[1]{{\bfseries\color{brandTeal}#1}}
% One cited contribution in a scorecard cell: code + name in bold, then
% an eval-specific short description.
% \par separates consecutive issues; no trailing blank line in the cell.
\def\gl@issuesep{}
\newcommand{\issue}[3]{\gl@issuesep{\bfseries\textcolor{brandTeal}{#1} \glupfirst{#2}:} #3\gdef\gl@issuesep{\par}}
% Uppercase the first letter of a contribution/issue name so registry
% names (stored lowercase) render capitalised everywhere they appear.
\newcommand{\glupfirst}[1]{\gl@upfirst#1\gl@upend}
\def\gl@upfirst#1#2\gl@upend{\uppercase{#1}#2}
% ---- Dimension registry ---------------------------------------------
% \definedimension{key}{scorecard row label}{report heading}{description}{contributions}
% Headings, row labels and contributions are defined ONCE here.
\newcommand{\definedimension}[5]{%
  \expandafter\def\csname dim@row@#1\endcsname{#2}%
  \expandafter\def\csname dim@title@#1\endcsname{#3}%
  \expandafter\def\csname dim@desc@#1\endcsname{#4}%
  \expandafter\def\csname dim@sub@#1\endcsname{#5}%
  \expandafter\def\csname dim@assess@#1\endcsname{\textbf{?}}%
  \expandafter\def\csname dim@issue@#1\endcsname{---}}
% Per-report: \setdimension{key}{\assess...}{key issue for the scorecard}
% The scorecard table AND the audit-report boxes both read this, so the
% two artifacts can never disagree.
\newcommand{\setdimension}[3]{%
  \expandafter\def\csname dim@assess@#1\endcsname{#2}%
  \expandafter\def\csname dim@issue@#1\endcsname{#3}}
% Letter identifying each dimension (A--J); contributions are numbered
% A.1, A.2, ... so findings and the framework diagram can cite them.
\newcommand{\dimensionletter}[2]{\expandafter\def\csname dim@letter@#1\endcsname{#2}}
\newcommand{\dimletter}[1]{\csname dim@letter@#1\endcsname}
% Validity aspect each dimension operationalises (Auditing Framework sheet)
\newcommand{\dimensionaspect}[2]{\expandafter\def\csname dim@aspect@#1\endcsname{#2}}
\newcommand{\dimaspect}[1]{\csname dim@aspect@#1\endcsname}
\newcommand{\dimrow}[1]{\csname dim@row@#1\endcsname}
\newcommand{\dimtitle}[1]{\csname dim@title@#1\endcsname}
\newcommand{\dimdesc}[1]{\csname dim@desc@#1\endcsname}
\newcommand{\dimsub}[1]{\csname dim@sub@#1\endcsname}
\newcommand{\dimassess}[1]{\csname dim@assess@#1\endcsname}
\newcommand{\dimissue}[1]{\csname dim@issue@#1\endcsname}

\dimensionletter{construct}{A}
\dimensionletter{dataset}{C}
\dimensionletter{contentvalidity}{B}
\dimensionletter{scaffold}{D}
\dimensionletter{harness}{E}
\dimensionletter{environment}{F}
\dimensionletter{grading}{G}
\dimensionletter{resources}{H}
\dimensionletter{informativeness}{I}
\dimensionsubbase{construct}{-1}
\dimensionaspect{construct}{Construct validity}
\dimensionaspect{dataset}{Implementation validity}
\dimensionaspect{contentvalidity}{Content validity}
\dimensionaspect{scaffold}{Implementation validity}
\dimensionaspect{harness}{Implementation validity}
\dimensionaspect{environment}{Implementation validity}
\dimensionaspect{grading}{Implementation validity}
\dimensionaspect{resources}{Implementation validity}
\dimensionaspect{informativeness}{Construct validity}

\definedimension{construct}{Construct validity}{Construct validity}{%
  Does performance on the eval validly measure the capability or behaviour the eval aims to assess?}{%
  \gsub{measurement distortion}{flaws in implementation validity dimensions distort measurement of the target construct},
  \gsub{contamination}{benchmark items or their solutions were present in training data or otherwise accessible during training},
  \gsub{memorisation}{performance depends on recalling a memorised solution rather than exercising the intended capability},
  \gsub{eval awareness}{models recognise the evaluation context and alter their behaviour as a result},
  \gsub{sandbagging}{models deliberately or strategically underperform relative to their capability},
  \gsub{confounds}{scores are systematically affected by factors unrelated to the target construct},
  \gsub{proxy measurement}{the measured outcome is only an imperfect proxy for the target capability or behaviour},
  \gsub{capability vs propensity}{the evaluation conflates what a model can do with what it tends to do}}


  \definedimension{contentvalidity}{Content validity}{Content validity}{%
  Do the tasks adequately represent the target domain and situations the evaluation aims to cover?}{%
  \gsub{coverage gaps}{important parts of the target domain or capability are absent or underrepresented},
  \gsub{unrepresentative task distribution}{the distribution of tasks differs materially from the target domain}}

\definedimension{dataset}{Task Specification}{Task Specification}{%
  Are individual tasks correctly specified, solvable, and free from defects that affect performance?}{%
  \gsub{incorrect reference answer}{the reference answer is incorrect or inconsistent with the task},
  \gsub{impossible tasks}{no correct answer is attainable as posed},
  \gsub{missing information}{required parameters or context are not supplied},
  \gsub{guessability}{tasks can be solved using superficial cues rather than the intended competence},
  \gsub{prompt defects}{the prompts are ambiguous, incomplete, misleading, or otherwise fail to specify correctly what the model should do},
  \gsub{hidden requirements}{success depends on unstated conventions or assumptions},
  \gsub{unintended shortcuts}{answers are reachable without performing the intended work}}


\definedimension{scaffold}{Scaffolding}{Scaffolding}{%
  Does the scaffolding provide the model with an appropriate setup for performing the task?}{%
  \gsub{system prompt issues}{system-level instructions are ambiguous, misleading, or otherwise distort performance},
  \gsub{planning or agent loop}{the agent structure constrains or alters performance},
  \gsub{memory \& context strategy}{the strategy for retaining and presenting context loses or obscures information needed to solve the task},
  \gsub{retry/error feedback}{failures are surfaced poorly or recovery opportunities are handled inconsistently},
  \gsub{coaching}{the scaffolding provides hints or information that artificially improves performance}}

\definedimension{harness}{Harness}{Harness}{%
  Does the evaluation infrastructure correctly execute the specified task and scaffolding?}{%
  \gsub{tool-call handling}{tool calls are parsed, routed, or executed incorrectly},
  \gsub{submission/termination logic}{episodes terminate earlier or later than intended},
  \gsub{context delivery}{task materials or interaction history reach the model incompletely},
  \gsub{message handling}{messages are truncated, reordered, duplicated, or otherwise mishandled},
  \gsub{state management}{evaluation state is lost, corrupted, or inconsistently maintained},
  \gsub{harness bugs}{other defects in the evaluation infrastructure affect performance},
  \gsub{harness sensitivity}{results change materially across equivalent harnesses}}

\definedimension{environment}{Environment}{Environment}{%
  Does the task environment and its resources function as specified?}{%
  \gsub{tool failures}{tools error, malfunction, or hang during episodes},
  \gsub{missing resources}{files, packages, or services assumed by the task are absent},
  \gsub{broken files \& dependencies}{inputs or dependencies are corrupt, incompatible, or unreadable},
  \gsub{non-determinism}{the environment varies between otherwise equivalent runs},
  \gsub{information leakage}{the environment exposes answers or unintended hints},
  \gsub{implementation differs from specification}{the environment behaves differently from its documented design}}

\definedimension{grading}{Grading}{Grading}{%
  Does the grading procedure correctly determine whether task performance satisfies the evaluation criteria?}{%
  \gsub{false positives and false negatives}{the grading procedure incorrectly classifies responses as satisfying or failing the evaluation criteria},
  \gsub{underspecified criteria}{the grading criteria do not clearly determine what counts as satisfying them},
  \gsub{judge errors}{LLM judges make systematic, inconsistent, or otherwise erroneous grading decisions},
  \gsub{surface-form sensitivity}{otherwise equivalent responses receive different scores because of differences in wording, formatting, or presentation},
  \gsub{incorrect partial credit}{partial scores do not appropriately reflect the quality or correctness of the response},
  \gsub{grader exploitation}{submissions can manipulate or exploit the grading procedure}}

\definedimension{resources}{Resource limits}{Resource limits}{%
  Do resource constraints provide an appropriate opportunity for models to perform on the task?}{%
  \gsub{turn/token/time limits}{limits terminate productive attempts before the model can complete the task},
  \gsub{resource sensitivity}{performance changes materially with the available resource budget},
  \gsub{unequal constraint effects}{the same nominal constraint binds models differently}}

\definedimension{informativeness}{Informativeness}{Informativeness}{%
  Does the evaluation provide enough variation and signal to distinguish relevant differences between models?}{%
  \gsub{saturation}{frontier models cluster at the attainable ceiling, limiting the benchmark's ability to distinguish between them},
  \gsub{floor/ceiling effects}{the attainable score range compresses meaningful differences between models},
  \gsub{clustering}{model scores cluster tightly relative to measurement uncertainty, providing little discriminative power between models}}


% ---- Scorecard breakdown table (generated) ---------------------------
% Which dimensions appear on the scorecard, and in what order. Set per
% report (typically most to least critical); delete a key to omit its
% row. NOTE: no spaces around the commas -- the keys are used verbatim.
\newcommand{\scorecardorder}[1]{\def\gl@scorder{#1}}
\scorecardorder{construct,dataset,contentvalidity,scaffold,harness,environment,grading,resources,informativeness}
\newcommand{\scorecardbreakdown}{%
\noindent
\begin{dsbox}[top=1mm, bottom=1mm, before skip=4pt, after skip=4pt]{Audit assessment breakdown}
\renewcommand{\arraystretch}{1.0}%
\gdef\gl@scrows{}%
\renewcommand*{\do}[1]{\gappto\gl@scrows{\dimtitle{##1} & \dimassess{##1} & \gdef\gl@issuesep{}\dimissue{##1} \\ \hline }}%
\expandafter\docsvlist\expandafter{\gl@scorder}%
\noindent\begin{tabularx}{\linewidth}{|L{0.58}|C{0.52}|L{1.9}|}
\hline
\textbf{Dimension} & \textbf{Assessment} & \textbf{Key contributions} \\ \hline
\gl@scrows
\end{tabularx}
\end{dsbox}}

% ---- Report part scaffolding -----------------------------------------
% Title row for a report part: "Part Name -- <eval>"
% Eval name as shown in every part title
\newcommand{\evaltitle}{\textcolor{brandTeal}{\eevalname}}
\newcommand{\reporttitle}[1]{%
  \noindent{\LARGE\itshape \textbf{#1} -- \evaltitle}\par\medskip}
% Lettered subsections a), b), c) with unique hyperref anchors per part
\newcommand{\letteredsubsections}[1]{%
  \setcounter{subsection}{0}%
  \renewcommand{\thesubsection}{\alph{subsection})}%
  \renewcommand{\theHsubsection}{#1.\alph{subsection}}}
% Wrapper for a whole report part: symmetric margins, ToC entry, title.
% \begin{reportpart}{Title}{anchorkey}{label} ... \end{reportpart}
\newenvironment{reportpart}[3]{%
  \phantomsection
  \addcontentsline{toc}{section}{#1}%
  \label{#3}%
  \adjustwidth{-10mm}{0mm}%
  \letteredsubsections{#2}%
  \reporttitle{#1}}
 {\endadjustwidth}

% ---- One audited dimension in the audit report -----------------------
% \begin{dimensionreport}{key} narrative (+ findings) \end{dimensionreport}
% Heading, assessment and subcriteria come from the registry/\setdimension.
% Figure inside a box. LaTeX float environments (\begin{figure}) cannot
% be used inside tcolorboxes, so this renders the image inline with a
% real, numbered, referenceable caption via \captionof.
% Usage: \boxfigure[width fraction]{file}{caption}{fig:label}
\newcommand{\boxfigure}[4][0.95]{%
  \par\begin{center}
  \includegraphics[width=#1\linewidth, height=0.62\textheight, keepaspectratio]{#2}\\[2pt]
  {\captionsetup{font=small, labelfont={bf,small}, textfont=small, width=0.9\linewidth}%
   \captionof{figure}{#3}\label{#4}}%
  \end{center}\par}

% Labelled paragraphs used inside a dimension box
\newcommand{\dimsummary}[1]{\par\smallskip\noindent\textbf{Summary:}~#1\par}
% Generic two-column bulleted list from a comma-separated item list
\newcommand{\gltwocol}[1]{%
  \gdef\gl@colA{}\gdef\gl@colB{}\booltrue{gl@colA}%
  \renewcommand*{\do}[1]{%
    \ifbool{gl@colA}%
      {\gappto\gl@colA{\textbullet~##1\par}\boolfalse{gl@colA}}%
      {\gappto\gl@colB{\textbullet~##1\par}\booltrue{gl@colA}}}%
  \docsvlist{#1}%
  \begin{minipage}[t]{0.48\linewidth}\linespread{0.95}\selectfont\raggedright\gl@colA\end{minipage}\hfill
  \begin{minipage}[t]{0.48\linewidth}\linespread{0.95}\selectfont\raggedright\gl@colB\end{minipage}}
% Observed concerns: comma-separated items rendered as a bulleted
% two-column list (same style as the scoring criteria); use registry
% terminology for the items, with specifics in parentheses.
\newcommand{\dimconcerns}[1]{%
  \par\smallskip\noindent\textbf{Observed concerns:}\par\nopagebreak\smallskip
  {\renewcommand*{\do}[1]{\noindent\textbullet~##1\par}%
   \docsvlist{#1}}\par\smallskip}
% Same rendering for concerns that are possible but were not observed
\newcommand{\dimpotential}[1]{%
  \par\smallskip\noindent\textbf{Potential concerns:}\par\nopagebreak\smallskip
  {\renewcommand*{\do}[1]{\noindent\textbullet~##1\par}%
   \docsvlist{#1}}\par\smallskip}
% One audited dimension: a dsbox-style titled box (the dimension name is
% the title bar, matching every other datasheet box), breakable.
\newtcolorbox{dimensionreport}[1]{%
  enhanced, breakable, sharp corners, gl continued,
  colback=white, colframe=brandTeal, boxrule=0.8pt,
  colbacktitle=brandTeal, coltitle=white,
  fonttitle=\bfseries,
  title={\dimletter{#1}.\ \MakeUppercase{\dimtitle{#1}}},
  title after break={\dimletter{#1}.\ \MakeUppercase{\dimtitle{#1}} CONT.},
  left=2mm, right=2mm, top=2mm, bottom=2mm,
  toptitle=1mm, bottomtitle=1mm,
  before upper={\textbf{Assessment:} \dimassess{#1}\par}
}

% Optional assessment-table layout. Existing reports retain dimensionreport.
% Navigation uses absolute report pages, since section page counters restart.
\newcommand{\auditdestination}[1]{%
  \phantomsection\label{audit:#1}\zref@label{auditpage:#1}}
\newcommand{\auditcontentsrow}[3][0]{%
  \par\noindent\hspace*{#1mm}%
  \hyperref[audit:#2]{#3}\nobreak\leaders\hbox{\kern2pt.\kern2pt}\hfill
  \hyperref[audit:#2]{\zref@extractdefault{auditpage:#2}{abspage}{?}}\par}
\newtcolorbox{dimensionreview}[1]{%
  enhanced, breakable, sharp corners, gl continued,
  colback=white, colframe=brandTeal, boxrule=0.8pt,
  colbacktitle=brandTeal, coltitle=white, fonttitle=\bfseries,
  title={\dimletter{#1}.\ \MakeUppercase{\dimtitle{#1}}},
  title after break={\dimletter{#1}.\ \MakeUppercase{\dimtitle{#1}} CONT.},
  left=2mm, right=2mm, top=2mm, bottom=2mm,
  toptitle=1mm, bottomtitle=1mm}
% Keep the assessment and its coverage table together when a box spans pages.
\newcommand{\dimensionoverview}[3]{%
  \noindent\begin{minipage}{\linewidth}
  \auditdestination{dimension:#1}%
  \textbf{Overall Assessment:} \dimassess{#1}\par\smallskip
  #2\par
  \contributionassessment{#3}%
  \end{minipage}\par}
\newcommand{\contributionassessment}[1]{%
  \par\medskip\noindent\begin{minipage}{\linewidth}
  \textbf{Contribution Assessment}\par\smallskip
  \small\renewcommand{\arraystretch}{1.15}%
  \begin{tabularx}{\linewidth}{|L{0.9}|L{0.7}|L{1.4}|}
  \hline
  \rowcolor{brandTeal!10}
  \textbf{Contribution} & \textbf{Assessment} & \textbf{Summary / evidence} \\ \hline
  #1
  \end{tabularx}
  \end{minipage}\par\smallskip}
\newcommand{\contributionrow}[4]{%
  \textbf{\textcolor{brandTeal}{#1}}~\glupfirst{#2} & #3 & #4 \\ \hline}
\newcommand{\evidencelink}[1]{\hyperref[audit:evidence:#1]{Evidence #1}}
\newcommand{\observedevidence}{%
  \par\medskip\noindent\textbf{Evidence for Observed Concerns}\par\nopagebreak\smallskip}
\newenvironment{concernevidence}[3]{%
  \begin{concern}{#1}{#2}{#3}\auditdestination{evidence:#1}}
  {\end{concern}}

