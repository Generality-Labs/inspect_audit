% ==================================================================
% auditframework.sty --- Generality Labs audit-report framework
%
% Defines the shared audit criteria and how assessments are presented:
%   - audit dimensions, contribution codes, and their descriptions;
%   - overall grades, dimension assessment labels, and colours;
%   - scorecards, finding boxes, figures, and report-wide pagination.
%
% Each report supplies its assessments through \setdimension and writes
% its findings in reports/<Eval>/Content.tex. The scorecard and dimension
% headings use those same assessments to keep their labels consistent.
%
% Related files:
%   template/GLaudit.cls       Page layout, branding, and section pagination
%   template/sections/        Shared scoring criteria page
%   reports/Example/          Starter report for new audits
%   template/legacy/          Older field-based sections using \setfield/\field
%
% Changes here apply to all reports when rebuilt. Keep report-specific
% findings in their Content.tex files. Framework versions follow publication
% milestones; draft edits are grouped under the current working version.
% ==================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{auditframework}[2026/08/18 Generality Labs eval-audit framework]

\RequirePackage{siunitx}
\RequirePackage{amssymb}
\RequirePackage{amsmath}
\RequirePackage[version=4]{mhchem}
\RequirePackage{csquotes}
\RequirePackage{amsfonts}
\RequirePackage{xcolor}
\RequirePackage{makecell}
\RequirePackage{subcaption}
\RequirePackage{multirow}%
\RequirePackage{ragged2e}
\RequirePackage{longtable}
\RequirePackage{colortbl}
\RequirePackage{arydshln}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{ragged2e}
\RequirePackage{enumitem}
\RequirePackage{threeparttable}
\RequirePackage{hyperref}
\RequirePackage[all]{hypcap}
\RequirePackage{float}
\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    filecolor=magenta,
    urlcolor=blue,
    pdftitle={Evaluation Audit Report},
    pdfpagemode=FullScreen,
