%%% DATASHEET-STYLE SCORECARD MACHINERY %%%
\definecolor{brandTeal}{RGB}{67,131,122}   % sampled from the Generality Labs logo

% When a breakable box splits across pages, close each continued part with
% a teal rule and a small italic "continued" marker at the bottom left.
\tcbset{gl continued/.style={
  overlay first={%
    \draw[tcbcolframe, line width=0.8pt] (frame.south west) -- (frame.south east);
    \node[anchor=north west, font=\scriptsize\itshape, text=tcbcolframe,
          inner sep=1.5pt] at ([xshift=1mm]frame.south west)
      {$\hookrightarrow$\,continued};},
  overlay middle={%
    \draw[tcbcolframe, line width=0.8pt] (frame.south west) -- (frame.south east);
    \node[anchor=north west, font=\scriptsize\itshape, text=tcbcolframe,
          inner sep=1.5pt] at ([xshift=1mm]frame.south west)
      {$\hookrightarrow$\,continued};}}}

% Section box with a teal title bar (datasheet look).
% Usage: \begin{dsbox}{Section title} ... \end{dsbox}
\newtcolorbox{dsbox}[2][]{%
  enhanced, sharp corners, gl continued,
  colback=white, colframe=brandTeal, boxrule=0.8pt,
  colbacktitle=brandTeal, coltitle=white,
  fonttitle=\bfseries,
  title={\MakeUppercase{#2}},
  left=2mm, right=2mm, top=2mm, bottom=2mm,
  toptitle=1mm, bottomtitle=1mm,
  #1
}

% A "Label: value" line inside a dsbox
\newcommand{\dsfield}[2]{\noindent\textbf{#1:}~#2\par\vspace{2pt}}
% Aligned variant: the value column starts at a fixed offset (optional
% argument, default 30mm) so consecutive values line up. Wrapped lines
% align under the value, not the label.
\newcommand{\dsfieldA}[3][30mm]{%
  \noindent\hangindent=#1\hangafter=1%
  \makebox[#1][l]{\textbf{#2:}}#3\par\vspace{2pt}}

% Letter grades, coloured on the concern scale:
% A = green, B = orange, C = red, D = deep red (S as A, E as D)
\newcommand{\gradeS}{\textcolor{ratingGreen}{\textbf{S}}}
\newcommand{\gradeA}{\textcolor{ratingGreen}{\textbf{A}}}
\newcommand{\gradeB}{\textcolor{ratingAmber}{\textbf{B}}}
\newcommand{\gradeC}{\textcolor{ratingRed}{\textbf{C}}}
\newcommand{\gradeD}{\textcolor{ratingDarkRed}{\textbf{D}}}
\newcommand{\gradeE}{\textcolor{ratingDarkRed}{\textbf{E}}}

% Rendering of the overall score set with \evalscore{...} in the
\commitref{[commit]}	% Eval version/commit audited (top-right header)
% DOCUMENT REFERENCE NUMBERS block; picks the colour for the letter.
\newcommand{\evalgrade}{%
  \ifdefstring{\eevalscore}{S}{\gradeS}{%
  \ifdefstring{\eevalscore}{A}{\gradeA}{%
  \ifdefstring{\eevalscore}{B}{\gradeB}{%
  \ifdefstring{\eevalscore}{C}{\gradeC}{%
  \ifdefstring{\eevalscore}{D}{\gradeD}{%
  \ifdefstring{\eevalscore}{E}{\gradeE}{\textbf{\eevalscore}}}}}}}%
}

% Colour of the overall grade as a named colour (for the badge frame
% and letter). Resolved at \begin{document}, after \evalscore is set.
\colorlet{gradeColor}{brandTeal}
\AtBeginDocument{%
  \ifdefstring{\eevalscore}{S}{\colorlet{gradeColor}{ratingGreen}}{%
  \ifdefstring{\eevalscore}{A}{\colorlet{gradeColor}{ratingGreen}}{%
  \ifdefstring{\eevalscore}{B}{\colorlet{gradeColor}{ratingAmber}}{%
  \ifdefstring{\eevalscore}{C}{\colorlet{gradeColor}{ratingRed}}{%
  \ifdefstring{\eevalscore}{D}{\colorlet{gradeColor}{ratingDarkRed}}{%
  \ifdefstring{\eevalscore}{E}{\colorlet{gradeColor}{ratingDarkRed}}{}}}}}}%
}

% Description text for each overall grade. \evalgradetext expands to the
% description matching \evalscore{...}, so the quality box always agrees
% with the grade set in the DOCUMENT REFERENCE NUMBERS block.
\newcommand{\gradetextA}{No obvious issues.}
\newcommand{\gradetextB}{Minor issues, but unlikely to produce misleading results.}
\newcommand{\gradetextC}{Notable issues, but evaluation still contains
  some useful signal.}
\newcommand{\gradetextD}{Serious issues, and the evaluation is very unlikely to contain useful
  signal.}
\newcommand{\evalgradetext}{%
  \ifdefstring{\eevalscore}{A}{\gradetextA}{%
  \ifdefstring{\eevalscore}{B}{\gradetextB}{%
  \ifdefstring{\eevalscore}{C}{\gradetextC}{%
  \ifdefstring{\eevalscore}{D}{\gradetextD}{[description for grade
  \eevalscore]}}}}%
}

% Per-dimension assessments, five-step scale
% (letter grades are reserved for the overall score only)
\definecolor{ratingDarkRed}{HTML}{7B1010}
\newcommand{\assessCritical}{\textcolor{ratingDarkRed}{\textbf{Critical concern}}}
\newcommand{\assessMajor}{\textcolor{ratingRed}{\textbf{Major concern}}}
\newcommand{\assessMinor}{\textcolor{ratingAmber}{\textbf{Minor concern}}}
\newcommand{\assessNone}{\textcolor{ratingGreen}{\textbf{No concern}}}
\definecolor{ratingSlate}{HTML}{546E7A}
\newcommand{\assessNA}{\textcolor{ratingGrey}{\textbf{Not applicable}}}         % dimension not applicable to this eval
\newcommand{\assessNotAssessed}{\textcolor{ratingSlate}{\textbf{Not assessed}}} % applicable, but outside this audit's scope
\newcommand{\assessOK}{\assessNone}   % legacy alias

% Importance labels for the breakdown table
\newcommand{\impHigh}{\textbf{High}}
\newcommand{\impMed}{Medium}
\newcommand{\impLow}{Low}

% Untitled breakable teal box for content that sits under a numbered
% subsection heading (audit report dimensions, description sections).
% Takes no options so content may safely start with a [placeholder].
\newtcolorbox{dimbox}{%
  enhanced, breakable, sharp corners,
  colback=white, colframe=brandTeal, boxrule=0.8pt,
  left=2mm, right=2mm, top=2mm, bottom=2mm
}

% Card for a contribution not raised as a concern, so every registry
% contribution is accounted for. Status is one of: not observed
% (assessed, nothing material found), not assessed (outside this
% audit's scope), not relevant (does not apply to this eval).
%   \begin{contribution}{G.4}{surface-form sensitivity}{not assessed}
%     note text
%   \end{contribution}
\newtcolorbox{contribution}[3]{%
  enhanced, breakable, gl continued,
  sharp corners, colback=black!3, colframe=black!25, boxrule=0.5pt,
  left=2mm, right=2mm, top=1.5mm, bottom=1.5mm,
  before skip=5pt, after skip=5pt, fontupper=\small,
  before upper={\noindent{\bfseries\textcolor{ratingGrey}{#1}}~\textbf{\glupfirst{#2}}%
    \hfill{\itshape\textcolor{ratingGrey}{#3}}\par\smallskip}}

% Light per-concern note card used under "Observed concerns": a tinted
% panel headed by the contribution code + name, holding terse note
% bullets (flat list, no nesting).
%   \begin{concern}{G.1}{false positives and false negatives}{\assessMajor}
%     \item ... \item ...
%   \end{concern}
\newtcolorbox{concern}[3]{%
  enhanced, breakable, sharp corners, gl continued,
  colback=brandTeal!4, colframe=brandTeal!40, boxrule=0.5pt,
  left=2mm, right=2mm, top=1.5mm, bottom=1.5mm,
  before skip=5pt, after skip=5pt, fontupper=\small,
  before upper={\noindent{\bfseries\textcolor{brandTeal}{#1}}~\textbf{\glupfirst{#2}}%
    \hfill{\small#3}\par\smallskip}}
% Tight bullet list for concern-card notes; figures may follow it inside
% the same card via \boxfigure.
\newenvironment{cnotes}%
  {\begin{itemize}[nosep, leftmargin=4mm, itemsep=1.5pt]}%
  {\end{itemize}}

% Light box listing example subcriteria under an audited dimension.
% These are prompts for the assessor, not a checklist.
\newtcolorbox{subcriteriabox}{%
  sharp corners,
  colback=brandTeal!6, colframe=brandTeal!50, boxrule=0.5pt,
  left=2mm, right=2mm, top=1mm, bottom=1mm,
  fontupper=\small
}

% Large rounded grade badge (top-right of the scorecard page).
% Frame and letter take the colour of the grade set with \evalscore.
\newcommand{\gradebadge}[1]{%
  \begin{tikzpicture}
    \node[rectangle, rounded corners=2mm, draw=gradeColor, line width=1.4pt,
          minimum width=12mm, minimum height=12mm]
      {\fontsize{22}{24}\selectfont\textbf{\textcolor{gradeColor}{#1}}};
  \end{tikzpicture}%
}
