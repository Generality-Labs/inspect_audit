% inspect_audit's layout on top of the pinned GL template (publishers/template/), loaded
% after auditframework by the generated report.tex. The pinned files stay as shipped;
% what the generated report needs differently is redefined here.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{inspectaudit}[2026/11/24 inspect_audit layout for generated GL reports]
\RequirePackage{auditframework}

% ---- Dimension overview -------------------------------------------------
% The template keeps the overview and its contribution table in one minipage, which
% cannot break. Generated explanations make it taller than a page: the breakable
% dimension box then left whole pages blank before it and ran it past the footer.
% Here it is ordinary paragraphs, and the table is one tabularx per row, so the box
% breaks between rows.
\renewcommand{\dimensionoverview}[3]{%
  \auditdestination{dimension:#1}%
  \noindent\textbf{Overall Assessment:} \dimassess{#1}\par\smallskip
  #2\par
  \contributionassessment{#3}}
% (the header and each row share these column widths)
\renewcommand{\contributionassessment}[1]{%
  \par\medskip\noindent\textbf{Contribution Assessment}\par\nopagebreak\smallskip
  {\small\renewcommand{\arraystretch}{1.15}%
   \par\noindent\begin{tabularx}{\linewidth}{|L{0.75}|L{0.5}|L{1.75}|}\hline
   \rowcolor{brandTeal!10}\textbf{Contribution} & \textbf{Assessment} & \textbf{Summary} \\ \hline
   \end{tabularx}\par\nopagebreak
   #1}\par\medskip}
\renewcommand{\contributionrow}[4]{%
  \par\nointerlineskip\noindent
  \begin{tabularx}{\linewidth}{|L{0.75}|L{0.5}|L{1.75}|}
  \textbf{\textcolor{brandTeal}{#1}}~\glupfirst{#2} & #3 & #4 \\ \hline
  \end{tabularx}\par}

% ---- Scorecard key contributions: code and name only -----------------
% (the explanation is in the dimension's part; one page holds the table)
\newcommand{\iaissue}[3]{%
  \gl@issuesep{\bfseries\textcolor{#3}{#1}}~\glupfirst{#2}\gdef\gl@issuesep{\par}}

% ---- Excerpts: verbatim evidence, quoted by the publisher -------------
% Recorded output (code, a command, a tool's output):
%   \begin{iaexcerpt}{caption} \iaxline{indent}{...}... \end{iaexcerpt}
% Each \iaxline is one recorded line, spaces kept; a line too long for the box
% continues under its own indentation (indent: its leading spaces), a little further in.
% Prose (a prompt, a model's message, a document), as a block quotation:
%   \begin{iaquote}{caption} \iaqpar{...}... \end{iaquote}
% The caption is a plain label, linked to its sample where there is one.
% \iaxelided{n} says how many selected lines are not shown.
% The template sets its text in OT1, which has no typewriter braces, quotes or angle
% brackets: excerpts use T1, declared here if nothing else has.
\RequirePackage[varqu,scaled=0.86]{zi4}
\@ifundefined{T1-cmd}{\input{t1enc.def}}{}
\tcbset{ia excerpt/.style={%
  enhanced, breakable, sharp corners, colframe=brandTeal, boxrule=0pt, leftrule=2pt,
  left=3mm, right=2mm, top=1.5mm, bottom=1.5mm,
  before skip=6pt plus 2pt, after skip=6pt plus 2pt}}
% (a linked caption in the rule's colour: a label first, a link second)
\newcommand{\iacaption}[1]{%
  \noindent{\hypersetup{urlcolor=brandTeal}\small\bfseries #1}\par\nopagebreak\vspace{3pt}}
\newtcolorbox{iaexcerpt}[1]{%
  ia excerpt, colback=black!3, fontupper=\footnotesize,
  before upper={\setlength{\parskip}{0pt}\raggedright\iacaption{#1}%
    \fontencoding{T1}\ttfamily\selectfont}}
\newcommand{\iaxline}[2]{%
  \par\noindent\hangindent=\dimexpr #1\fontdimen2\font+3\fontdimen2\font\relax
  \hangafter=1 #2\mbox{}\par}
\newtcolorbox{iaquote}[1]{%
  ia excerpt, colback=brandTeal!4, fontupper=\small,
  before upper={\setlength{\parskip}{0pt}\iacaption{#1}}}
\newcommand{\iaqpar}[1]{\par\noindent #1\par\vspace{3pt}}
% in prose: `inline code`, and a fenced block's lines
\newcommand{\iatt}[1]{{\fontencoding{T1}\ttfamily\selectfont #1}}
\newcommand{\iaqcode}[2]{{\footnotesize\fontencoding{T1}\ttfamily\selectfont\iaxline{#1}{#2}}}
\newcommand{\iaxelided}[1]{%
  \par\noindent{\normalfont\itshape\color{black!55}[\ldots\ #1 more lines not shown]}\par}

\endinput
