  "additionalProperties": false,
  "description": "One defect record. See docs/finding-schema-envelope.md.",
  "properties": {
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "dimension": {
      "enum": [
        "construct",
        "contentvalidity",
        "dataset",
        "scaffold",
        "harness",
        "environment",
        "grading",
        "resources",
        "informativeness"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "effect": {
      "anyOf": [
        {
          "$ref": "#/$defs/Effect"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fingerprint": {
      "title": "Fingerprint",
      "type": "string"
    },
    "fingerprint_version": {
      "default": 1,
      "title": "Fingerprint Version",
      "type": "integer"
    },
    "fixed": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "history": {
      "items": {
        "$ref": "#/$defs/StatusChange"
      },
      "title": "History",
      "type": "array"
    },
    "introduced": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "locations": {
      "items": {
        "discriminator": {
          "mapping": {
            "artifact": "#/$defs/ArtifactLocation",
            "code": "#/$defs/CodeLocation",
            "log": "#/$defs/LogLocation",
            "sample": "#/$defs/SampleLocation",
            "scorer": "#/$defs/ScorerLocation",
            "transcript": "#/$defs/TranscriptLocation",
            "url": "#/$defs/UrlLocation"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CodeLocation"
          },
          {
            "$ref": "#/$defs/SampleLocation"
          },
          {
            "$ref": "#/$defs/TranscriptLocation"
          },
          {
            "$ref": "#/$defs/LogLocation"
          },
          {
            "$ref": "#/$defs/ScorerLocation"
          },
          {
            "$ref": "#/$defs/ArtifactLocation"
          },
          {
            "$ref": "#/$defs/UrlLocation"
          }
        ]
      },
      "minItems": 1,
      "title": "Locations",
      "type": "array"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "rule": {
      "title": "Rule",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "enum": [
        "none",
        "minor",
        "major",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "status": {
      "enum": [
        "hypothesis",
        "supported",
        "qualified",
        "retracted"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "suppressions": {
      "items": {
        "$ref": "#/$defs/Suppression"
      },
      "title": "Suppressions",
      "type": "array"
    }
  },
  "required": [
    "fingerprint",
    "producer",
    "rule",
    "subject",
    "dimension",
    "severity",
    "status",
    "summary",
    "locations",
    "run_id",
    "source"
  ],
  "title": "Finding",
  "type": "object"
}
