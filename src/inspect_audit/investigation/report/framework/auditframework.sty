% Rating colours (used in the scorecard and findings)
\definecolor{ratingGreen}{HTML}{2E7D32}   % Effective / Compliant
\definecolor{ratingAmber}{HTML}{ED6C02}   % Partially effective / Minor issues
\definecolor{ratingRed}{HTML}{C62828}     % Ineffective / Non-compliant
\definecolor{ratingGrey}{HTML}{616161}    % Not assessed / Out of scope
\definecolor{ratingGreenBg}{HTML}{E8F5E9}
\definecolor{ratingAmberBg}{HTML}{FFF3E0}
\definecolor{ratingRedBg}{HTML}{FFEBEE}
\definecolor{ratingGreyBg}{HTML}{F5F5F5}

% Scorecard rating cells: \ratingGood, \ratingPartial, \ratingPoor, \ratingNA
\newcommand{\ratingcell}[3]{\cellcolor{#1}\textcolor{#2}{\textbf{#3}}}
\newcommand{\ratingGood}[1][Effective]{\ratingcell{ratingGreenBg}{ratingGreen}{#1}}
\newcommand{\ratingPartial}[1][Partially effective]{\ratingcell{ratingAmberBg}{ratingAmber}{#1}}
\newcommand{\ratingPoor}[1][Ineffective]{\ratingcell{ratingRedBg}{ratingRed}{#1}}
\newcommand{\ratingNA}[1][Not assessed]{\ratingcell{ratingGreyBg}{ratingGrey}{#1}}

% Severity labels for findings: \sevCritical, \sevMajor, \sevMinor, \sevObs
\newcommand{\sevbox}[2]{\colorbox{#1}{\textcolor{white}{\small\textbf{~#2~}}}}
\newcommand{\sevCritical}{\sevbox{ratingRed}{CRITICAL}}
\newcommand{\sevMajor}{\sevbox{ratingAmber}{MAJOR}}
\newcommand{\sevMinor}{\sevbox{ratingGreen}{MINOR}}
\newcommand{\sevObs}{\sevbox{ratingGrey}{OBSERVATION}}

% Counter and environment for audit findings.
% Usage:
%   \begin{finding}{Short title of the finding}{\sevMajor}
%     \findingfield{Criterion}{...}
%     \findingfield{Condition (what we found)}{...}
%     \findingfield{Evidence}{...}
%     \findingfield{Risk / Impact}{...}
%     \findingfield{Recommendation}{...}
%     \findingfield{Management response}{...}
%   \end{finding}
\newcounter{finding}
\renewcommand{\thefinding}{F-\arabic{finding}}   % so \ref on a finding label prints "F-1"
% Optional first argument names the finding after the contribution it
% evidences (e.g. [C.1]); \ref on its label then prints that code.
% Without it, findings fall back to sequential F-n numbering.
\newtcolorbox{finding}[3][]{%
  enhanced, breakable,
  colback=white, colframe=black!70,
  boxrule=0.6pt, arc=2mm,
  left=3mm, right=3mm, top=2mm, bottom=2mm,
  code={\refstepcounter{finding}\ifblank{#1}{}{\def\@currentlabel{#1}}},
  title={\textbf{Finding \ifblank{#1}{\thefinding}{#1}: #2} \hfill #3},
  title after break={\textbf{Finding \ifblank{#1}{\thefinding}{#1}\ (cont.)} \hfill #3},
  colbacktitle=black!8, coltitle=black,
  fonttitle=\normalsize
}
\newcommand{\findingfield}[2]{\par\smallskip\noindent\textbf{#1:}~#2\par}

