# Generated by inspect_audit: the investigator's own box, beside the benchmark's.
# The benchmark's packages are not installed here: its grader runs in the
# benchmark's own task, and its source is copied in for reading. With internet,
# the investigator can install anything else it needs.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        librsvg2-bin ca-certificates curl git jq ripgrep poppler-utils procps time \
    && rm -rf /var/lib/apt/lists/*

# pandas + pyarrow for exported attempts; pillow to measure an image as well as
# look at one; scipy + sympy for independent numerical and symbolic checks
RUN pip install --no-cache-dir pandas pyarrow pillow scipy sympy

WORKDIR /audit
